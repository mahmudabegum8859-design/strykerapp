<resources>
    <style name="Theme.OPXDemon" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/opxdemon_accent</item>
        <item name="colorPrimaryDark">?attr/colorSurface</item>
        <item name="colorPrimaryVariant">@color/opxdemon_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/opxdemon_accent</item>
        <item name="colorSecondaryVariant">@color/opxdemon_accent_contrast</item>
        <item name="colorOnSecondary">@color/opxdemon_accent_contrast</item>
        <item name="android:navigationBarColor">@color/toolbar_color</item>
        <item name="android:statusBarColor">@color/toolbar_color</item>
        <item name="switchStyle">@style/Widget.OPXDemon.Switch</item>
        <item name="android:textViewStyle">@style/Widget.OPXDemon.TextView</item>
        <item name="android:buttonStyle">@style/Widget.OPXDemon.Button</item>
        <item name="materialCardViewStyle">@style/Widget.OPXDemon.CardView</item>
        <item name="floatingActionButtonStyle">@style/Widget.OPXDemon.FAB</item>
        <item name="materialAlertDialogTheme">@style/Widget.OPXDemon.AlertDialog</item>
        <item name="backgroundColor">#1e1e1e</item>
    </style>
    <style name="Theme.OPXDemonFloatingDialog" parent="Theme.OPXDemon">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

</resources>