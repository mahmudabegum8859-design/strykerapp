  "app": {
    "versionCode": 5,
    "versionName": "1.4.1",
    "url": "https://github.com/mahmudabegum8859-design/strykerapp/releases/download/v1.4.1/OPXdemon-1.4.1.apk",
    "sha256": "45962d26423c85154435cf0fd601633d0a3b67fbea51323ef30eed1653eb5738",
    "size": 27500415,
    "mandatory": false,
    "changelog": "OPXdemon 1.4.1 (hotfix)\n- Fixed \"Size mismatch\" during rootless install/update: the per-architecture manifest entry for arm64 still pointed at the previous rootfs size/sha256, so the download of the new rootfs failed verification. All rootfs entries (flat + arm64/armhf/i386/amd64) now match the release.\n- Installer self-heals on stale manifests: if a payload download fails size/checksum verification, the app now drops the cached manifest, fetches a fresh one and retries once, so a release update can never brick the install again.\n- versionCode 5, versionName 1.4.1."
  },
  "news": [
    {
      "id": 5,
      "title": "OPXdemon 1.4.1 \u2014 hotfix: rootfs size mismatch + stale-manifest self-heal",
      "description": "OPXdemon 1.4.1 (versionCode 5): fixes the \"Size mismatch: got 462418320, expected 427974567\" error during rootless install (the arm64 per-arch manifest entry was stale). The installer now also self-heals: any size/checksum mismatch drops the cached manifest, fetches a fresh one and retries once, so future payload updates can never block the install.",
